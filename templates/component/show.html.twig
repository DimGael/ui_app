{% extends 'base.html.twig' %}

{% block title %}Component - {{ component.name }}{% endblock %}

{% block body %}
    <div class="flex flex-col h-[calc(100vh-theme(spacing.16))] bg-slate-50">

        <!-- Toolbar -->
        <div class="flex items-center justify-between px-6 h-12 bg-white border-b border-slate-200 flex-shrink-0">

            <!-- Left: title + status -->
            <div class="flex items-center gap-3">
                <h1 class="text-sm font-semibold text-slate-900">Playground</h1>
                <span class="text-slate-300">·</span>
                <div class="flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-xs text-slate-500" id="status-text">Ready</span>
                </div>
            </div>

            <!-- Center: device toggle -->
            <div class="flex items-center bg-slate-100 rounded-lg p-0.5">
                <button data-device="mobile"
                        class="device-btn px-3 py-1 rounded-md text-xs font-medium text-slate-500 hover:text-slate-900 transition-colors">
                    Mobile
                </button>
                <button data-device="tablet"
                        class="device-btn px-3 py-1 rounded-md text-xs font-medium text-slate-500 hover:text-slate-900 transition-colors">
                    Tablet
                </button>
                <button data-device="desktop"
                        class="device-btn px-3 py-1 rounded-md text-xs font-medium text-white bg-blue-600 shadow-sm transition-colors">
                    Desktop
                </button>
            </div>

            <!-- Right: actions -->
            <div class="flex items-center gap-2">
                <button id="reset-btn"
                        class="px-3 py-1.5 rounded-md text-xs font-medium text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors">
                    Reset
                </button>
                <button id="copy-btn"
                        class="px-3 py-1.5 rounded-md text-xs font-medium text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors">
                    Copy
                </button>
            </div>

        </div>

        <!-- Main split -->
        <div class="flex flex-1 min-h-0">

            <!-- Left pane (tabs) -->
            <div class="w-1/2 flex flex-col bg-[#0f172a] border-r border-slate-200">

                <!-- Tab bar -->
                <div class="flex items-center gap-1 px-3 h-10 border-b border-slate-700 flex-shrink-0 bg-[#0b1222]">
                    <button data-tab="code"
                            class="tab-btn flex items-center gap-2 px-3 py-1.5 rounded-md text-xs font-medium text-white bg-slate-800 transition-colors">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="16 18 22 12 16 6"/>
                            <polyline points="8 6 2 12 8 18"/>
                        </svg>
                        Code
                    </button>
                    <button data-tab="ai"
                            class="tab-btn flex items-center gap-2 px-3 py-1.5 rounded-md text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8 5.8 21.3l2.4-7.4L2 9.4h7.6z"/>
                        </svg>
                        Ask AI
                        <span
                            class="ml-1 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider bg-blue-500/20 text-blue-300 rounded">Beta</span>
                    </button>
                </div>

                <!-- TAB: Code -->
                <div id="tab-code" class="flex-1 flex flex-col min-h-0">

                    <!-- File tab -->
                    <div class="flex items-center gap-1 px-3 h-9 border-b border-slate-700 flex-shrink-0">
                        <div
                            class="flex items-center gap-1.5 px-3 py-1 rounded-t-md bg-slate-800 text-xs text-slate-300 font-medium">
                            <svg class="w-3 h-3 text-orange-400" viewBox="0 0 24 24" fill="currentColor">
                                <path
                                    d="M1.5 0h21l-1.91 21.563L11.977 24l-8.564-2.438L1.5 0zm17.09 4.413L5.41 4.41l.213 2.622 10.125.002-.255 2.716h-6.64l.24 2.573h6.182l-.366 3.523-2.91.804-2.956-.81-.188-2.11H6.25l.33 4.173L12 19.351l5.422-1.453.732-8.213H9.586l-.127-1.598 9.164-.001.127-1.673z"/>
                            </svg>
                            index.html
                        </div>
                    </div>

                    <!-- Code area -->
                    <div class="relative flex-1 overflow-hidden">
                        <div id="line-numbers"
                             class="absolute top-0 left-0 w-10 h-full py-4 text-right pr-2 text-xs font-mono text-slate-500 bg-[#0b1222] select-none pointer-events-none overflow-hidden">
                            1
                        </div>
                        <textarea
                            id="code-editor"
                            spellcheck="false"
                            class="absolute inset-0 pl-12 pr-4 py-4 w-full h-full bg-transparent text-slate-100 text-sm font-mono leading-5 resize-none outline-none caret-blue-400"
                        >
                            {{ component.htmlCode | raw }}
                        </textarea>
                    </div>

                    <!-- Editor footer -->
                    <div
                        class="flex items-center justify-between px-4 h-7 bg-[#0b1222] border-t border-slate-700 text-[11px] font-mono text-slate-500 flex-shrink-0">
                        <div class="flex items-center gap-3">
                            <span>HTML</span>
                            <span>·</span>
                            <span id="line-col">Ln 1, Col 1</span>
                        </div>
                        <span id="char-count">0 chars</span>
                    </div>

                </div>

                <!-- TAB: AI Chat -->
                <div id="tab-ai" class="hidden flex-1 flex-col min-h-0">

                    <!-- Chat header -->
                    <div class="flex items-center justify-between px-4 h-9 border-b border-slate-700 flex-shrink-0">
                        <div class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
                            <span class="text-xs font-medium text-slate-300">AI Assistant</span>
                        </div>
                        <button id="clear-chat"
                                class="text-[11px] font-medium text-slate-500 hover:text-slate-300 transition-colors">
                            Clear history
                        </button>
                    </div>

                    <!-- Messages -->
                    <div id="chat-messages" class="flex-1 overflow-y-auto px-4 py-4 space-y-4">

                        <!-- Welcome message -->
                        <div class="flex gap-3">
                            <div
                                class="flex-shrink-0 w-7 h-7 rounded-full bg-blue-500/20 border border-blue-500/30 flex items-center justify-center">
                                <svg class="w-3.5 h-3.5 text-blue-300" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8 5.8 21.3l2.4-7.4L2 9.4h7.6z"/>
                                </svg>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-xs font-semibold text-slate-300 mb-1">Assistant</p>
                                <div class="text-sm text-slate-400 leading-relaxed">
                                    Hi! I can modify the code for you. Try asking:
                                    <div class="mt-3 space-y-1.5">
                                        <button
                                            class="suggestion-btn block w-full text-left px-3 py-2 rounded-md bg-slate-800/60 hover:bg-slate-800 border border-slate-700 text-xs text-slate-300 transition-colors">
                                            "Change the color scheme to emerald"
                                        </button>
                                        <button
                                            class="suggestion-btn block w-full text-left px-3 py-2 rounded-md bg-slate-800/60 hover:bg-slate-800 border border-slate-700 text-xs text-slate-300 transition-colors">
                                            "Make the heading bigger and bolder"
                                        </button>
                                        <button
                                            class="suggestion-btn block w-full text-left px-3 py-2 rounded-md bg-slate-800/60 hover:bg-slate-800 border border-slate-700 text-xs text-slate-300 transition-colors">
                                            "Add a secondary outline button"
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Input area -->
                    <div class="border-t border-slate-700 p-3 flex-shrink-0 bg-[#0b1222]">
                        <form id="chat-form" class="flex items-end gap-2">
                            <div class="flex-1 relative">
              <textarea
                  id="chat-input"
                  rows="1"
                  placeholder="Describe what you want to change…"
                  class="w-full resize-none bg-slate-800/60 border border-slate-700 focus:border-blue-500 focus:bg-slate-800 rounded-lg px-3 py-2.5 pr-10 text-sm text-slate-100 placeholder-slate-500 outline-none transition-colors max-h-32"
              ></textarea>
                                <span class="absolute right-3 bottom-2.5 text-[10px] font-mono text-slate-600">⏎</span>
                            </div>
                            <button type="submit"
                                    class="flex-shrink-0 w-9 h-9 flex items-center justify-center rounded-lg bg-blue-600 hover:bg-blue-700 disabled:bg-slate-700 disabled:cursor-not-allowed text-white transition-colors"
                                    id="chat-submit">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2">
                                    <line x1="22" y1="2" x2="11" y2="13"/>
                                    <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                                </svg>
                            </button>
                        </form>
                        <p class="mt-2 text-[10px] text-slate-500">
                            The AI edits the code on the left. Changes appear live in the preview.
                        </p>
                    </div>

                </div>

            </div>

            <!-- Preview pane -->
            <div class="w-1/2 flex flex-col bg-slate-100 min-w-0">

                <div
                    class="flex items-center justify-between px-4 h-10 bg-white border-b border-slate-200 flex-shrink-0">
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                        <span class="ml-2 text-xs text-slate-400 font-mono">preview</span>
                    </div>
                    <button id="refresh-btn"
                            class="p-1 rounded hover:bg-slate-100 text-slate-400 hover:text-slate-700 transition-colors"
                            title="Refresh">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M23 4v6h-6M1 20v-6h6"/>
                            <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                        </svg>
                    </button>
                </div>

                <div class="flex-1 overflow-auto p-4 flex items-start justify-center min-h-0">
                    <div id="preview-wrapper"
                         class="bg-white rounded-md shadow-sm transition-all duration-300 w-full max-w-full"
                         style="min-height: 100%;">
                        <iframe
                            id="preview-frame"
                            class="w-full h-full rounded-md"
                            style="min-height: 600px;"
                            title="Preview"
                            sandbox="allow-scripts allow-same-origin"
                        ></iframe>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <script>
        (function () {
            const editor = document.getElementById('code-editor');
            const iframe = document.getElementById('preview-frame');
            const lineNumbers = document.getElementById('line-numbers');
            const lineCol = document.getElementById('line-col');
            const charCount = document.getElementById('char-count');
            const statusText = document.getElementById('status-text');
            const previewWrap = document.getElementById('preview-wrapper');
            const deviceBtns = document.querySelectorAll('.device-btn');
            const tabBtns = document.querySelectorAll('.tab-btn');
            const tabCode = document.getElementById('tab-code');
            const tabAi = document.getElementById('tab-ai');
            const copyBtn = document.getElementById('copy-btn');
            const resetBtn = document.getElementById('reset-btn');
            const refreshBtn = document.getElementById('refresh-btn');
            const chatForm = document.getElementById('chat-form');
            const chatInput = document.getElementById('chat-input');
            const chatMsgs = document.getElementById('chat-messages');
            const clearChat = document.getElementById('clear-chat');

            const defaultCode = editor.value;
            let debounceTimer;

            const devices = {mobile: '375px', tablet: '768px', desktop: '100%'};

            // -- Preview rendering --------------------------------------------------
            function buildHTML(body) {
                return `<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><script src="https://cdn.tailwindcss.com"><\/script><style>body{margin:0}</style></head><body>${body}</body></html>`;
            }

            function updatePreview() {
                statusText.textContent = 'Rendering…';
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    iframe.srcdoc = buildHTML(editor.value);
                    statusText.textContent = 'Ready';
                }, 300);
            }

            // -- Editor UI ----------------------------------------------------------
            function updateLineNumbers() {
                const lines = editor.value.split('\n').length;
                lineNumbers.innerHTML = Array.from({length: lines}, (_, i) => i + 1).join('<br>');
            }

            function updateStatus() {
                const pos = editor.selectionStart;
                const before = editor.value.substring(0, pos);
                const lines = before.split('\n');
                lineCol.textContent = `Ln ${lines.length}, Col ${lines[lines.length - 1].length + 1}`;
                charCount.textContent = `${editor.value.length} chars`;
            }

            editor.addEventListener('scroll', () => {
                lineNumbers.scrollTop = editor.scrollTop;
            });
            editor.addEventListener('keydown', (e) => {
                if (e.key === 'Tab') {
                    e.preventDefault();
                    const s = editor.selectionStart, e2 = editor.selectionEnd;
                    editor.value = editor.value.substring(0, s) + '  ' + editor.value.substring(e2);
                    editor.selectionStart = editor.selectionEnd = s + 2;
                }
            });
            editor.addEventListener('input', () => {
                updateLineNumbers();
                updateStatus();
                updatePreview();
            });
            editor.addEventListener('click', updateStatus);
            editor.addEventListener('keyup', updateStatus);

            // -- Device switch ------------------------------------------------------
            deviceBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    deviceBtns.forEach(b => {
                        b.classList.remove('text-white', 'bg-blue-600', 'shadow-sm');
                        b.classList.add('text-slate-500');
                    });
                    btn.classList.add('text-white', 'bg-blue-600', 'shadow-sm');
                    btn.classList.remove('text-slate-500');
                    previewWrap.style.maxWidth = devices[btn.dataset.device];
                });
            });

            // -- Tab switch ---------------------------------------------------------
            tabBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    tabBtns.forEach(b => {
                        b.classList.remove('text-white', 'bg-slate-800');
                        b.classList.add('text-slate-400');
                    });
                    btn.classList.add('text-white', 'bg-slate-800');
                    btn.classList.remove('text-slate-400');

                    if (btn.dataset.tab === 'code') {
                        tabCode.classList.remove('hidden');
                        tabCode.classList.add('flex');
                        tabAi.classList.add('hidden');
                        tabAi.classList.remove('flex');
                    } else {
                        tabCode.classList.add('hidden');
                        tabCode.classList.remove('flex');
                        tabAi.classList.remove('hidden');
                        tabAi.classList.add('flex');
                        chatInput.focus();
                    }
                });
            });

            // -- Toolbar actions ----------------------------------------------------
            copyBtn.addEventListener('click', async () => {
                await navigator.clipboard.writeText(editor.value);
                const o = copyBtn.textContent;
                copyBtn.textContent = 'Copied!';
                setTimeout(() => {
                    copyBtn.textContent = o;
                }, 1500);
            });
            resetBtn.addEventListener('click', () => {
                if (confirm('Reset the code to the default snippet?')) {
                    editor.value = defaultCode;
                    updateLineNumbers();
                    updateStatus();
                    updatePreview();
                }
            });
            refreshBtn.addEventListener('click', () => {
                iframe.srcdoc = buildHTML(editor.value);
            });

            // -- Chat ---------------------------------------------------------------
            function addMessage(role, content) {
                const isUser = role === 'user';
                const wrapper = document.createElement('div');
                wrapper.className = 'flex gap-3';
                wrapper.innerHTML = isUser
                    ? `
        <div class="flex-shrink-0 w-7 h-7 rounded-full bg-slate-700 border border-slate-600 flex items-center justify-center">
          <svg class="w-3.5 h-3.5 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-xs font-semibold text-slate-300 mb-1">You</p>
          <div class="text-sm text-slate-400 leading-relaxed whitespace-pre-wrap break-words"></div>
        </div>`
                    : `
        <div class="flex-shrink-0 w-7 h-7 rounded-full bg-blue-500/20 border border-blue-500/30 flex items-center justify-center">
          <svg class="w-3.5 h-3.5 text-blue-300" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8 5.8 21.3l2.4-7.4L2 9.4h7.6z"/></svg>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-xs font-semibold text-slate-300 mb-1">Assistant</p>
          <div class="text-sm text-slate-400 leading-relaxed whitespace-pre-wrap break-words"></div>
        </div>`;
                wrapper.querySelector('div.flex-1 > div').textContent = content;
                chatMsgs.appendChild(wrapper);
                chatMsgs.scrollTop = chatMsgs.scrollHeight;
            }

            // Auto-resize textarea
            chatInput.addEventListener('input', () => {
                chatInput.style.height = 'auto';
                chatInput.style.height = Math.min(chatInput.scrollHeight, 128) + 'px';
            });

            // Submit on Enter (without Shift)
            chatInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    chatForm.requestSubmit();
                }
            });

            chatForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const message = chatInput.value.trim();
                if (!message) return;
                addMessage('user', message);
                chatInput.value = '';
                chatInput.style.height = 'auto';

                // TODO: replace with real API call

                const response = await fetch('/api/component/modify', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({prompt: message, htmlCode: editor.value})
                });

                const data = await response.json();
                editor.value = data.code;
                console.log(data, data.code);
                updateLineNumbers();updateStatus();updatePreview();
                addMessage('assistant', "Modification done !");
            });

            // Suggestion buttons
            document.addEventListener('click', (e) => {
                if (e.target.closest('.suggestion-btn')) {
                    chatInput.value = e.target.textContent.trim().replace(/^"|"$/g, '');
                    chatInput.focus();
                }
            });

            // Clear history
            clearChat.addEventListener('click', () => {
                if (confirm('Clear the chat history?')) {
                    chatMsgs.innerHTML = '';
                }
            });

            // Init
            updateLineNumbers();
            updateStatus();
            updatePreview();
        })();
    </script>

{% endblock %}
